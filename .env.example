# =============================================================================
# CrewAware - environment settings
#
# Copy to .env and edit:   cp .env.example .env && nano .env
# .env is never committed (see .gitignore). Apply changes with:
#   docker compose up -d --force-recreate crewaware
#
# Site, units, groups, repeaters, branding and contact rules are set in the web UI
# (Setup tab) and stored in PostgreSQL, not here.
# =============================================================================

# --- Required ----------------------------------------------------------------

# Password for the PostgreSQL user "crewaware". Set it before the first start. Changing it later
# also requires changing it inside PostgreSQL (ALTER USER crewaware PASSWORD ...).
POSTGRES_PASSWORD=CHANGE-THIS-POSTGRES-PASSWORD

# First administrator, created on startup if it does not exist. At least 12 characters.
# Once the account exists this value is ignored. To change the password later:
#   echo 'new password here' | docker compose exec -T crewaware crewaware set-password admin
CREWAWARE_ADMIN_USERNAME=admin
CREWAWARE_ADMIN_PASSWORD=CHANGE-THIS-ADMIN-PASSWORD

# --- Optional ----------------------------------------------------------------

# Port dispatchers browse to (http://<server-address>:8080). Keep the server on a local network.
CREWAWARE_PORT=8080

# 1 = run the built-in simulator and seed a demo site (for trying it out). Leave 0 for a real site.
CREWAWARE_SIM=0
# Simulator only: how often the parked demo units check in, in seconds.
CREWAWARE_SIM_PARKED_SECS=900

# 1 = mark the login cookie Secure. Only set this when the app is served over HTTPS.
CREWAWARE_COOKIE_SECURE=0

# Log verbosity: error, warn, info (recommended) or debug.
RUST_LOG=info

# Image name and tag when using a prebuilt image instead of building locally.
CREWAWARE_IMAGE=crewaware
CREWAWARE_VERSION=local
